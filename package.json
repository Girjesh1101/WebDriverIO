{
  "name": "webdriverio",
  "version": "1.0.0",
  "description": "wdio e2e tests",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "wdio": "wdio run ./wdio.conf.ts",
    "demo": "wdio run ./wdio.conf.ts --cucumberOpts.tags='@demo'",
    "somke": "wdio run ./wdio.conf.ts --cucumberOpts.tags='@smoke'",
    "test:demo": "npx wdio config/wdio.test.conf.ts --cucumberOpts.tags='@demo'",
    "test:debug": "npx wdio config/wdio.test.conf.ts --cucumberOpts.tags='@demo' > output.txt",
    "uat:demo": "npx wdio config/wdio.uat.conf.ts --cucumberOpts.tags='@demo'"
  },
  "keywords": [
    "wdio",
    "cucumber",
    "e2e",
    "tests"
  ],
  "author": "Automation",
  "license": "ISC",
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/node": "^25.2.3",
    "@wdio/cli": "^9.24.0",
    "@wdio/cucumber-framework": "^9.24.0",
    "@wdio/globals": "^9.23.0",
    "@wdio/local-runner": "^9.24.0",
    "@wdio/spec-reporter": "^9.24.0",
    "chai": "4.0.2",
    "dotenv": "^17.3.1",
    "expect-webdriverio": "^5.6.4",
    "winston": "^3.19.0"
  },
  "dependencies": {
    "chai-webdriverio": "^1.0.0"
  }
}
